# ==========================================================
# AgroDoc - variables de entorno (desarrollo)
# Copia este archivo a .env:  cp .env.example .env
# ==========================================================

# --- Base de datos -------------------------------------------------------
POSTGRES_USER=agrodoc
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=agrodoc_db

# --- Aplicación ----------------------------------------------------------
ENVIRONMENT=development
# Solo si corres el API fuera de Docker (la app lee Backend/.env):
# DATABASE_URL=postgresql+psycopg://agrodoc:cambiame@localhost:5432/agrodoc_db

# --- Autenticación -------------------------------------------------------
# HS256 exige >= 32 bytes. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=cambiame-en-produccion-minimo-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Recuperación de contraseña -----------------------------------------
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_MAX_REQUESTS_PER_WINDOW=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15

# --- Correo --------------------------------------------------------------
# console = imprime el código en los logs del API (ideal para Postman)
# brevo   = envía correo real (requiere BREVO_API_KEY y EMAIL_FROM)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@agrodoc.local
EMAIL_FROM_NAME=AgroDoc
BREVO_API_KEY=

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Inferencia (detection) ---------------------------------------------
MODEL_PATH=/models/model.onnx
CONFIDENCE_THRESHOLD=0.70
