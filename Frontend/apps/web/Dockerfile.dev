FROM node:22-alpine

RUN corepack enable
WORKDIR /app

# Copiamos solo archivos de dependencias del monorepo para aprovechar la caché
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/ ./packages/

# Caché persistente de pnpm
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

EXPOSE 5173

CMD ["pnpm", "--filter", "@agrodoc/web", "dev", "--host", "0.0.0.0"]
